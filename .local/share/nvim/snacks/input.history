  local dap = require("dap")
  
  vim.ui.input({ 
    prompt = "Args (Leer lassen für Clipboard): ",
    kind = "center_win" 
  }, function(input)
    -- 1. Wenn nichts eingetippt wurde, nimm direkt das System-Clipboard
    if not input or input == "" then
      input = vim.fn.getreg("+")
    end

    if input and input ~= "" then
      -- 2. Radikale Bereinigung: Ersetze alle Newlines, Tabs und Wagenrückläufe durch normale Leerzeichen
      input = input:gsub("[\r\n\t]", " ")
      input = vim.trim(input)
      
      -- 3. Argumente sauber parsen (erlaubt auch Argumente in Anführungszeichen, z.B. --name "Mein Text")
      local args = {}
      -- Dieser Regex fängt sowohl normale Wörter als auch Strings in "..." sauber ab
      for match in string.gmatch(input, '[^%s"]+|"([^"]*)"') do
        -- Entferne die Anführungszeichen für den Debugger, falls vorhanden
        local clean_arg = match:gsub('^"', ''):gsub('"$', '')
        table.insert(args, clean_arg)
      end
      
      -- 4. Debugger starten
      local config = dap.configurations[vim.bo.filetype]
      if config and config[1] then
        local run_config = vim.tbl_deep_extend("force", {}, config[1])
        run_config.args = args
        
        dap.run(run_config)
      else
        vim.notify("Keine Debug-Konfiguration gefunden!", vim.log.levels.WARN)
      end
    end
  end)
