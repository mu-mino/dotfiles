  local dap = require("dap")
  
  -- Wir nutzen dressing.nvim für ein großes, stabiles Eingabefenster
  vim.ui.input({ 
    prompt = "Arguments: ",
    -- Das zwingt dressing.nvim (falls installiert), ein breites Fenster zu öffnen
    kind = "center_win" 
  }, function(input)
    if input and input ~= "" then
      -- Verhindert, dass Whitespaces am Ende Fehler verursachen
      input = vim.trim(input)
      
      -- WICHTIG: Zerlegt den Riesen-String sauber in einzelne Argumente
      local args = {}
      for arg in string.gmatch(input, "%S+") do
        table.insert(args, arg)
      end
      
      -- Holt die Konfiguration für die aktuelle Sprache
      local config = dap.configurations[vim.bo.filetype]
      if config and config[1] then
        local run_config = vim.tbl_deep_extend("force", {}, config[1])
        run_config.args = args
        
        -- Startet den Debugger mit der sauberen Liste
        dap.run(run_config)
      else
        vim.notify("Keine Debug-Konfiguration gefunden!", vim.log.levels.WARN)
      end
    end
  end)
